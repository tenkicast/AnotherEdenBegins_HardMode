<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AnotherEdenHardMode</AssemblyName>
    <RootNamespace>AEBHardMode</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <!-- Where the game is installed. Every reference below is resolved from it, and
       none of these DLLs are redistributable, so they are NOT in this repository.
       Override without editing this file:
           dotnet build -c Release -p:GameDir="D:\Games\Another Eden Begins Demo"
       or set a GameDir environment variable. -->
  <PropertyGroup Condition="'$(GameDir)' == ''">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Another Eden Begins Demo</GameDir>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.Core.dll')"
           Text="Could not find BepInEx at '$(GameDir)'. Set GameDir to your game folder, e.g. dotnet build -c Release -p:GameDir=&quot;D:\Games\Another Eden Begins Demo&quot;. The game must have been launched once with BepInEx installed so that BepInEx\interop\ has been generated." />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll</HintPath></Reference>
    <Reference Include="Sava.Main"><HintPath>$(GameDir)\BepInEx\interop\Sava.Main.dll</HintPath></Reference>
    <Reference Include="Sava.Core"><HintPath>$(GameDir)\BepInEx\interop\Sava.Core.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
